# ============================================
# IntelliMart Environment Variables
# Developer: Asad
# ============================================

# Database (Supabase / Neon / PlanetScale)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_CURRENCY_SYMBOL="$"
NEXT_PUBLIC_APP_NAME="IntelliMart"

# JWT Auth
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_SECRET="your-refresh-token-secret"

# Stripe Payment Gateway
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Subscription Price IDs (create in Stripe Dashboard → Products → Add product)
NEXT_PUBLIC_STRIPE_PLUS_PRICE_ID="price_..."
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID="price_..."

# Clerk Authentication (optional - for social login)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Cloudinary (Image Upload)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# Email (Resend / SendGrid)
RESEND_API_KEY="re_..."
EMAIL_FROM="IntelliMart <noreply@intellimart.dev>"

# Platform Commission (percentage)
PLATFORM_COMMISSION=10

# Anthropic Claude AI
GEMINI_API_KEY="AIza..."


# Rate Limiting
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."
